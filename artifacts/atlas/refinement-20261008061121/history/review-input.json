  "notes": [
    {
      "id": "LIFE-031",
      "observations": [
        "Four symmetric corner meanders, double border and short fringes appear on the thin rug.",
        "Front orthographic view confirms a low uninterrupted edge; top closeups separately inspect the textile.",
        "The top closeup shows the pale corner spiral and double border woven into the blue field, with visible orthogonal weave variation and short edge fringe.",
        "Recolour changes the motif and matching fringe to pink while the blue field remains unchanged; undo restores the pale woven motif."
      ]
    },
    {
      "id": "LIFE-032",
      "observations": [
        "Drawer is at reference-left, control module at right, and tools hang on the left side.",
        "Continuous diagonal supports and the recessed stone insert are visible."
      ]
    },
    {
      "id": "LIFE-037",
      "observations": [
        "Left opaque door, right open shelves and upper drawer now match the reference arrangement.",
        "Final door handle faces the cabinet centre and the hinges are on the outer edge; the back service opening remains visible."
      ]
    },
    {
      "id": "LIFE-038",
      "observations": [
        "Two real through-cutouts, wood edging, backsplash and four raised metal corner pieces are visible."
      ],
      "limits": [
        "Cutout layout is not a certified simultaneous fit of the independently sized hob and sink masters."
      ]
    },
    {
      "id": "LIFE-039",
      "observations": [
        "The broad box hood has continuous chamfers and an open top duct.",
        "Hob rings, radial pan supports and separate knobs are visible; hob and wall hood intentionally form two assembly groups."
      ]
    },
    {
      "id": "LIFE-040",
      "observations": [
        "A continuous sloping basin, thick lip, faucet, valve and mounting ears replace the earlier stepped basin.",
        "The actual drain is partly obscured by the basin lip in the angled view; geometry ray checks verify the opening."
      ]
    },
    {
      "id": "LIFE-041",
      "observations": [
        "Two opaque doors are on the left and two tinted glass doors on the right.",
        "Paired central handles, thin inset enamel relief and inner shelves are visible; glass remains translucent."
      ]
    },
    {
      "id": "LIFE-042",
      "observations": [
        "Open shelves are now on the left with paired long doors on the right.",
        "Raised shallow door motifs, continuous frames, centre handles and independent corner hardware are visible."
      ]
    },
    {
      "id": "LIFE-043",
      "observations": [
        "The control display is now on the reference-right door and shows separately modeled cyan symbols.",
        "Paired long centre handles, inset door panels, dark seals and lower ventilation slats are visible; the white metal side remains an independent finish."
      ]
    },
    {
      "id": "LIFE-044",
      "observations": [
        "The former voxel staircase is replaced by a closed 48-sided continuous pot shell with a deep visible interior and rolled rim.",
        "Both wooden ear handles remain open; metal mounts and inner fastener ends are visible.",
        "Front clay view shows the tapered lower shell and separate foot ring."
      ],
      "limits": [
        "Fine wear and roughness variation remain for a later surface pass."
      ]
    },
    {
      "id": "LIFE-045",
      "observations": [
        "The stepped lid is now a continuous translucent blue-grey dome with visible thickness.",
        "The dark metal lip, brass clamp and bridge grip are separate; the grip opening and curved front silhouette are clear."
      ]
    },
    {
      "id": "LIFE-046",
      "observations": [
        "The original stair-stepped vessel is replaced by one thick continuous ceramic bowl.",
        "Its inner floor, rolled lip, foot ring and separate teal meander band are visible in the material view; front clay confirms the silhouette."
      ]
    }
  ]
