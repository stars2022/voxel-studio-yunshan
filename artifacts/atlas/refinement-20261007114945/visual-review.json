  "models": [
    {
      "id": "LIFE-008",
      "observed": "搁板方向按参考调整，铜挂杆为圆截面，板边和连续背撑清楚。",
      "remaining": "当前母版为独立内胆；参考图的外壳、门和衣物仍需由独立资产组成展示。"
    },
    {
      "id": "LIFE-009",
      "observed": "可见石脚和角铁、镜面枢轴、铜细边、暖光细条已成形。",
      "remaining": "环境反射仍较平；未实现平面场景镜像，台面瓶盒未并入镜架母版。"
    },
    {
      "id": "LIFE-019",
      "observed": "键帽分离、旋钮置于画面右侧，线缆与托板倒角可辨。",
      "remaining": "参考键帽字符不清晰，未虚构键位；仍可进一步细化表面尺度和细小接口。"
    },
    {
      "id": "LIFE-020",
      "observed": "折臂改为连续斜杆，圆转轴、灯框、暖光窗清楚，木材层没有被局部点光冲白。",
      "remaining": "静态姿态；关节动画、局部光的真实灯具分布及环境照明仍未绑定。"
    },
    {
      "id": "LIFE-023",
      "observed": "坐垫圆弧没有台阶，凳腿外撇，横撑及四脚抱件可见；顶面织纹方向正常。",
      "remaining": "坐垫表面仍可继续向参考块面细节微调，不能把纹理网格视为实际分块。"
    },
    {
      "id": "LIFE-024",
      "observed": "两个翻斗具有真实倾角和空腔，把手接上面板，前板和边框不再平贴柜体。",
      "remaining": "鞋履为独立资产；翻斗是静态形状，未声明抽屉运动或完整开闭净空。"
    },
    {
      "id": "LIFE-025",
      "observed": "层板倒角、深铁护栏、加高的真实墙挂板可见。",
      "remaining": "书本、盆花与装饰画仍按独立清单组件处理，后续组合展示需要补充。"
    },
    {
      "id": "LIFE-026",
      "observed": "双轨、端帽、墙座和八组浅色挂扣比原细杆更接近参考比例。",
      "remaining": "全长机位下单个挂扣较小；轨道滑动未绑定。"
    },
    {
      "id": "LIFE-027",
      "observed": "连续褶面消除了侧边台阶；两个回纹位于浅色下缘，近照能辨织纹。换色使主布和回纹一起变红，浅色地纹保持，撤销恢复。",
      "remaining": "参考色纹作为受光用途贴图保留在素色视图内；没有把贴图细节计为几何或真实织物模拟。"
    },
    {
      "id": "LIFE-028",
      "observed": "仰视下灯窗、木框、铜压边和黑角帽层次可辨，正面可见天花固定盘。",
      "remaining": "整片灯窗仍偏平；后续可细化表面层次与场景照明，当前非光学仿真。"
    },
    {
      "id": "LIFE-029",
      "observed": "背板、悬臂与灯体真实连接，玻璃和光芯分层后外框可辨。",
      "remaining": "参考灯面的小回纹及更丰富的框架细节仍待下一轮；静态发光不等于现场照明完成。"
    },
    {
      "id": "LIFE-030",
      "observed": "插孔改到画面左侧且包括斜孔，两个摇杆和右侧显示面独立；连续壳边与最小铜扣保持。",
      "remaining": "插孔已用真实射线验证贯通，但在浅色背景上深度对比偏弱；设备状态和开关功能未绑定。"
